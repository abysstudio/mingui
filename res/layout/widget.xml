<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/buddy" android:layout_width="72dp" android:layout_height="76dp"
            android:scaleType="fitCenter" android:contentDescription="@string/app_name" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFF2F4F8" android:textSize="20sp" android:textStyle="bold" android:singleLine="true" />
            <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FF8A93A6" android:textSize="12sp" android:singleLine="true"
                android:layout_marginTop="1dp" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
                android:max="100" android:progressDrawable="@drawable/widget_progress" />
            <ProgressBar android:id="@+id/progress_done" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
                android:max="100" android:progress="100" android:visibility="gone"
                android:progressDrawable="@drawable/widget_progress_done" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp" android:background="#FF262A33" />

    <LinearLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c0" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c1" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c2" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c3" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c4" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c5" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n5" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m5" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r6" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c6" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n6" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m6" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r7" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_row"
        android:paddingStart="6dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView android:id="@+id/c7" android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_box" android:contentDescription="@null" />
        <TextView android:id="@+id/n7" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textColor="#FFF2F4F8"
            android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/m7" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FF8A93A6" android:textSize="12sp"
            android:drawablePadding="3dp" android:singleLine="true" />
    </LinearLayout>
    <TextView android:id="@+id/more" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="6dp" android:paddingTop="4dp" android:textColor="#FF7C5CFF" android:textSize="12sp"
        android:visibility="gone" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="10dp" android:textColor="#FF8A93A6" android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
