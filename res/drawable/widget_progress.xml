<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#FF262A33" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape>
            <gradient android:angle="0" android:startColor="#FF7C5CFF" android:endColor="#FF4F8BFF" />
            <corners android:radius="4dp" />
        </shape></clip>
    </item>
</layer-list>
