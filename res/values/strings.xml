    <string name="privacy_title">Your data stays here</string>
    <string name="privacy_body">This app doesn\'t have Android\'s internet permission at all. Android itself enforces that: the app can\'t connect to anything, so it can\'t send your habits, your app list or anything else anywhere, not even by mistake.\n\nNo accounts, no ads, no analytics, no tracking. Backups are files you save and keep yourself.\n\nYou can check it: \"full network access\" is missing from this app\'s permission list.</string>
    <string name="privacy_perms_header">WHAT EACH PERMISSION IS FOR</string>
    <string name="overlay_why">Shows your checklist on top of apps you chose to block, and lets your buddy walk on screen. It never draws over apps you didn\'t pick.</string>
    <string name="usage_why">Tells the app which app is open, only to compare it with your block list. Nothing is recorded or shared.</string>
    <string name="notifications_why">A status line with a Pause button, plus the nudges you scheduled. Nothing else.</string>
    <string name="battery_why">Keeps Android from closing the blocker and buddy in the background.</string>
    <string name="root_title">Root access</string>
    <string name="root_why">Used only to hide the apps you block (and show them again), and to switch on this app\'s own permissions so you don\'t have to.</string>
    <string name="perm_back">Done! Brought you back.</string>
    <string name="accessory_none">None</string>
