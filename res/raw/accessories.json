        {"type": "circle", "x": "1ex+0.5lk", "y": 0, "r": 7, "stroke": 2, "color": "#1B1E26"},
        {"type": "line", "x1": "-1ex+7+0.5lk", "y1": 0, "x2": "1ex-7+0.5lk", "y2": 0, "stroke": 2, "color": "#1B1E26"},
        {"type": "circle", "x": "-1ex+0.5lk", "y": 0, "r": 6, "color": "#26FFFFFF"},
